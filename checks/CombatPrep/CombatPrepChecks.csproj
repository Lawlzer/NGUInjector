<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Performance checks measure the same optimized planner in both Debug and Release. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../NGUInjector/Managers/CombatPrepPlanner.cs" Link="CombatPrepPlanner.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceProjection.cs" Link="ResourceProjection.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceAllocation.cs" Link="ResourceAllocation.cs" />
  </ItemGroup>
</Project>
