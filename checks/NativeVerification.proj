<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <NativeSuites Condition="'$(NativeSuites)' == ''">PresetIntegration|CombatPrepIntegration|ManualAdventureOverlay|BlackBar|Ownership|TitanGold|PresetEquipment|GearEquip|OrdinaryPolicy|WinFormsBlood|StageTargetsNative|ResourceAggregation|AutoExp</NativeSuites>
    <SelectedSuites>|$(NativeSuites)|</SelectedSuites>
    <ProductionProject>$(MSBuildThisFileDirectory)..\NGUInjector\NGUInjector.csproj</ProductionProject>
    <FixtureProperties>Configuration=$(Configuration);DebugSymbols=true;DebugType=full;BuildProjectReferences=false</FixtureProperties>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build normal dependencies explicitly so variant properties never reach them. -->
    <NativeFixture Include="$(MSBuildThisFileDirectory)PresetIntegration\PresetIntegrationChecks.csproj" Condition="$(SelectedSuites.Contains('|PresetIntegration|')) or $(SelectedSuites.Contains('|AutoExp|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)CombatPrepIntegration\CombatPrepIntegrationChecks.csproj" Condition="$(SelectedSuites.Contains('|CombatPrepIntegration|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)ManualAdventureOverlay\ManualAdventureOverlayChecks.csproj" Condition="$(SelectedSuites.Contains('|ManualAdventureOverlay|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)BlackBarChecks.csproj" Condition="$(SelectedSuites.Contains('|BlackBar|')) or $(SelectedSuites.Contains('|OrdinaryPolicy|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)Ownership\OwnershipChecks.csproj" Condition="$(SelectedSuites.Contains('|Ownership|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)TitanGold\TitanGoldChecks.csproj" Condition="$(SelectedSuites.Contains('|TitanGold|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)Presets\EquipmentChecks.csproj" Condition="$(SelectedSuites.Contains('|PresetEquipment|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)GearEquip\GearEquipChecks.csproj" Condition="$(SelectedSuites.Contains('|GearEquip|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)OrdinaryPolicy\OrdinaryPolicyChecks.csproj" Condition="$(SelectedSuites.Contains('|OrdinaryPolicy|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)WinFormsBlood\WinFormsBloodChecks.csproj" Condition="$(SelectedSuites.Contains('|WinFormsBlood|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)PresetIntegration\PresetIntegrationChecks.csproj" Condition="$(SelectedSuites.Contains('|StageTargetsNative|'))">
      <AdditionalProperties>CustomBeforeMicrosoftCommonTargets=$(MSBuildThisFileDirectory)Presets\StageTargetsNative.targets;StartupObject=PresetStageTargetsNativeChecks;OutputPath=bin\stage-targets\;BaseIntermediateOutputPath=obj\stage-targets\;IntermediateOutputPath=obj\stage-targets\;MSBuildProjectExtensionsPath=$(MSBuildThisFileDirectory)PresetIntegration\obj\stage-targets\</AdditionalProperties>
    </NativeFixture>
    <NativeFixture Include="$(MSBuildThisFileDirectory)Presets\ResourceAggregationChecks.csproj" Condition="$(SelectedSuites.Contains('|ResourceAggregation|'))" />
    <NativeFixture Include="$(MSBuildThisFileDirectory)AutoExp\NativeChecks.csproj" Condition="$(SelectedSuites.Contains('|AutoExp|'))" />
  </ItemGroup>
  <Target Name="Restore">
    <MSBuild Projects="$(ProductionProject)" Targets="Restore" Properties="Configuration=$(Configuration)" BuildInParallel="false" StopOnFirstFailure="true" />
    <MSBuild Projects="@(NativeFixture)" Targets="Restore" Properties="$(FixtureProperties);RestoreRecursive=false" BuildInParallel="false" StopOnFirstFailure="true" />
  </Target>
  <Target Name="Build">
    <MSBuild Projects="$(ProductionProject)" Targets="Build" Properties="Configuration=$(Configuration)" BuildInParallel="false" StopOnFirstFailure="true" />
    <MSBuild Projects="@(NativeFixture)" Targets="Build" Properties="$(FixtureProperties)" BuildInParallel="false" StopOnFirstFailure="true" />
  </Target>
</Project>
