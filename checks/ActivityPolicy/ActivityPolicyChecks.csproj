<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../NGUInjector/Managers/ActivityPolicy.cs" Link="Production/ActivityPolicy.cs" />
    <Compile Include="../../NGUInjector/SimpleJson.cs" Link="Production/SimpleJson.cs" />
    <Compile Include="../../NGUInjector/JsonFiles.cs" Link="Production/JsonFiles.cs" />
    <EmbeddedResource Include="../../NGUInjector/Data/ActivityPolicies.json" LogicalName="NGUInjector.ActivityPolicies.json" Condition="'$(OmitPolicyResource)' != 'true'" />
  </ItemGroup>
</Project>
