<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\native\</OutputPath>
    <IntermediateOutputPath>obj\native\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj\native\</MSBuildProjectExtensionsPath>
    <AssemblyName>AutoExpNativeChecks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DefineConstants>NATIVE</DefineConstants>
    <StartupObject>AutoExpProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <ProjectReference Include="..\PresetIntegration\PresetIntegrationChecks.csproj" />
    <Compile Include="Program.cs" />
    <Compile Include="IntegrationChecks.cs" />
    <Compile Include="NativeBoundary.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
