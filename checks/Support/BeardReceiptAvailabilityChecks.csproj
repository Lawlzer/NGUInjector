<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/beard-receipt/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/beard-receipt/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BeardReceiptAvailabilityChecks.cs" />
    <Compile Include="../Beards/GameBoundary.cs" Link="GameBoundary.cs" />
    <Compile Include="../../NGUInjector/Managers/BeardManager.cs" Link="Production/BeardManager.cs" />
    <Compile Include="../../NGUInjector/Managers/ActivityPolicy.cs" Link="Production/ActivityPolicy.cs" />
    <Compile Include="../../NGUInjector/SimpleJson.cs" Link="Production/SimpleJson.cs" />
    <Compile Include="../../NGUInjector/JsonFiles.cs" Link="Production/JsonFiles.cs" />
    <EmbeddedResource Include="../../NGUInjector/Data/ActivityPolicies.json" LogicalName="NGUInjector.ActivityPolicies.json" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
