<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/BundleChecks/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/BundleChecks/$(Configuration)/</OutputPath>
    <AssemblyName>SaveTestBundleChecks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BundleChecks.cs" />
    <Compile Include="../../NGUInjector/SaveTestBundle.cs" Link="Production/SaveTestBundle.cs" />
    <Compile Include="../../NGUInjector/JsonFiles.cs" Link="Production/JsonFiles.cs" />
    <Compile Include="../../NGUInjector/SimpleJson.cs" Link="Production/SimpleJson.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
