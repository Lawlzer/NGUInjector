<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/BridgeChecks/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/BridgeChecks/$(Configuration)/</OutputPath>
    <AssemblyName>SaveSafetyBridgeChecks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.13" />
    <Compile Include="BridgeChecks.cs" />
    <Compile Include="BridgeBoundary.cs" />
    <Compile Include="../../NGUInjector/Main.SaveSafety.cs" Link="Production/Main.SaveSafety.cs" />
    <Compile Include="../../NGUInjector/SaveSafetyCatalog.cs" Link="Production/SaveSafetyCatalog.cs" />
    <Compile Include="../../NGUInjector/SimpleJson.cs" Link="Production/SimpleJson.cs" />
    <Compile Include="../../NGUInjector/JsonFiles.cs" Link="Production/JsonFiles.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
