<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>0649</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);PRESET_MODEL_CHECKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../NGUInjector/Managers/ActivityPolicy.cs" Link="Production/ActivityPolicy.cs" />
    <Compile Include="../../NGUInjector/JsonFiles.cs" Link="Production/JsonFiles.cs" />
    <Compile Include="../../NGUInjector/SimpleJson.cs" Link="Production/SimpleJson.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceProjection.cs" Link="Production/ResourceProjection.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceAllocation.cs" Link="Production/ResourceAllocation.cs" />
    <Compile Include="../../NGUInjector/Managers/DiggerAllocation.cs" Link="Production/DiggerAllocation.cs" />
    <Compile Include="../../NGUInjector/Managers/SupportProjection.cs" Link="Production/SupportProjection.cs" />
    <EmbeddedResource Include="../../NGUInjector/Data/ActivityPolicies.json" LogicalName="NGUInjector.ActivityPolicies.json" />
    <Compile Remove="EquipmentChecks.cs" />
    <Compile Include="../../NGUInjector/Managers/LoadoutPresetPlanner.cs" Link="LoadoutPresetPlanner.cs" />
    <Compile Include="../../NGUInjector/Managers/LoadoutPresetPlanner.Priorities.cs" Link="LoadoutPresetPlanner.Priorities.cs" />
    <Compile Include="../../NGUInjector/Managers/LoadoutPresetExecution.cs" Link="LoadoutPresetExecution.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceLanePriority.cs" Link="ResourceLanePriority.cs" />
    <Compile Include="../../NGUInjector/CustomPlans/LoadoutPreset.cs" Link="Production/LoadoutPreset.cs" />
    <Compile Include="../../NGUInjector/CustomPlans/PresetDefinitions.cs" Link="Production/PresetDefinitions.cs" />
    <EmbeddedResource Include="../../NGUInjector/Data/PresetDefinitions.json" LogicalName="NGUInjector.PresetDefinitions.json" />
  </ItemGroup>
</Project>
