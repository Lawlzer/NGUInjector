<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\resource-aggregation\</OutputPath>
    <BaseIntermediateOutputPath>obj\resource-aggregation\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <AssemblyName>ResourceAggregationChecks</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DefineConstants>RESOURCE_AGGREGATION_CHECKS</DefineConstants>
    <NoWarn>0649</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Compile Include="ResourceAggregationChecks.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceProjection.cs" Link="ResourceProjection.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
