    <Compile Include="../../NGUInjector/CustomPlans/PresetDefinitions.cs" />
    <EmbeddedResource Include="../../NGUInjector/Data/PresetDefinitions.json" LogicalName="NGUInjector.PresetDefinitions.json" />
    <Compile Include="../../NGUInjector/Managers/ResourceProjection.cs" />
    <Compile Include="../../NGUInjector/Managers/ResourceAllocation.cs" />
    <Compile Include="../../NGUInjector/Managers/DiggerAllocation.cs" />
    <Compile Include="../../NGUInjector/Managers/SupportProjection.cs" />
