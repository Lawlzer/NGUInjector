    <Compile Include="../Presets/Program.cs" />
    <Compile Include="../Presets/EmptySlotChecks.cs" />
    <Compile Include="../Presets/NumericChecks.cs" />
    <Compile Include="../Presets/ResourceAggregationChecks.cs" />
    <Compile Include="../Presets/SupportIntegrationChecks.cs" />
    <Compile Include="../Presets/MixedFocusChecks.cs" />
    <Compile Include="../Presets/ActivityChecks.cs" />
    <Compile Include="../Presets/SetupOnlyChecks.cs" />
    <Compile Include="../Presets/ResourceDemandChecks.cs" />
    <Compile Include="../Presets/LanePriorityChecks.cs" />
    <Compile Include="../Presets/ExecutionChecks.cs" />
    <Compile Include="../Presets/CapacityObjectiveChecks.cs" />
    <Compile Include="../../NGUInjector/Managers/LoadoutPresetPlanner.cs" />
